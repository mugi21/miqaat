<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notifications de prière (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarmes exactes : SCHEDULE_EXACT_ALARM (Android 12/12L, accordée par défaut,
         révocable) puis USE_EXACT_ALARM (Android 13+, accordée d'office aux apps dont
         la fonction principale est l'alarme — cas d'une app de prière). -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Replanifier la chaîne d'alarmes après un redémarrage -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Jouer l'adhan et le rappel nous-mêmes : un service d'avant-plan est le seul
         moyen de survivre à la fin du receiver d'alarme. FOREGROUND_SERVICE_SHORT_SERVICE
         (Android 14+) correspond au cas : quelques dizaines de secondes de son. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SHORT_SERVICE" />
    <!-- Vibrer nous-mêmes : depuis le réglage « mode d'alerte », la vibration
         n'est plus déléguée au canal de notification (D38). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Demander l'exclusion de l'optimisation de batterie. Refusée par Google
         Play sauf cas listés, mais l'application est distribuée hors Play
         (GPL, releases GitHub) — voir D35. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Position approximative : suffisante pour les horaires (précision « ville »),
         un seul fix ponctuel, jamais en arrière-plan -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Écoute du Coran (D41) : la SEULE fonctionnalité en réseau de l'application.
         Aucune fonction cœur — horaires, alarmes, Qibla, calendrier, adhkār, widget —
         n'y touche, et l'app reste entièrement utilisable hors ligne sans elle.
         Un seul hôte contacté (mp3quran.net et ses serveurs de fichiers), aucune
         donnée envoyée, aucun identifiant, toujours aucun SDK tiers. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- La lecture continue app fermée : contrairement à l'adhan (shortService,
         quelques dizaines de secondes), une récitation dure une heure. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Boussole Qibla : le magnétomètre est confortable mais non obligatoire
         (sans lui, l'écran affiche quand même l'angle de la Qibla). -->
    <uses-feature
        android:name="android.hardware.sensor.compass"
        android:required="false" />

    <!-- Écran de fiabilité : sans ces déclarations, `resolveActivity` renvoie null
         sur Android 11+ (filtrage de visibilité des paquets) et l'on ne saurait
         pas si l'écran de démarrage automatique de la surcouche existe.
         Volontairement une liste nominative plutôt que QUERY_ALL_PACKAGES. -->
    <queries>
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.oneplus.security" />
    </queries>

    <application
        android:name=".MiqaatApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Miqaat">
        <!-- singleTop : la notification d'une invocation réutilise l'activité déjà
             ouverte (onNewIntent) au lieu d'en empiler une seconde copie. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Miqaat"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notifications.PrayerAlarmReceiver"
            android:exported="false" />

        <!-- Lecture de l'adhan, du rappel ou d'une invocation, avec focus audio
             (met la musique en pause). Démarré depuis le receiver d'alarme exacte,
             cas exempté de l'interdiction de lancer un service d'avant-plan
             depuis l'arrière-plan. -->
        <service
            android:name=".notifications.AlertSoundService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!-- Lecture du Coran. exported="true" n'est pas une inattention : c'est
             MediaSessionService qui l'exige — les contrôles système, l'écran
             verrouillé, l'Assistant et Android Auto se lient à la session. Le
             service ne fait rien d'autre que jouer une URL de mp3quran.net. -->
        <service
            android:name=".quran.QuranPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Widget d'écran d'accueil. exported="false" suffit : le système est
             exempté et adresse ses diffusions au composant explicitement. -->
        <receiver
            android:name=".widget.NextPrayerWidget"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_prayer_info" />
        </receiver>

        <!-- exported="true" : toutes ces actions sont des diffusions protégées, que
             seul le système peut émettre — aucune application tierce ne peut les
             forger, et le receiver ignore tout ce qui ne figure pas dans sa liste.
             En contrepartie, on peut enfin le viser depuis `adb` sans root, ce qui
             rend la replanification vérifiable (D32). MY_PACKAGE_REPLACED et non
             PACKAGE_REPLACED : le second exigerait un <data> et vaudrait pour
             toutes les applications du téléphone. -->
        <receiver
            android:name=".notifications.RescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
