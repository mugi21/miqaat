<?xml version="1.0" encoding="utf-8"?>
<!-- Carte du widget : voile translucide (le fond d'écran transparaît) + liseré
     vert, puis la trame de mosaïque posée par-dessus. La trame est encartée de
     14dp pour ne jamais toucher les coins arrondis, qu'une layer-list ne sait
     pas rogner. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="@color/widget_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_outline" />
        </shape>
    </item>
    <item
        android:bottom="14dp"
        android:drawable="@drawable/widget_mosaic"
        android:left="14dp"
        android:right="14dp"
        android:top="14dp" />
</layer-list>
