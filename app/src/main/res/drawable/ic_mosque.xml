<?xml version="1.0" encoding="utf-8"?>
<!-- Mosquée minimaliste : deux minarets, une coupole surmontée d'un épi, et une
     façade percée d'une porte en arc et de trois losanges — une mosaïque réduite
     à l'essentiel (les creux sont obtenus par fillType evenOdd, pas par une
     seconde couleur : l'icône reste une silhouette d'un seul tenant).
     La couleur vient de @color/widget_accent, donc clair/sombre automatiques. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Minaret de gauche -->
    <path
        android:fillColor="@color/widget_accent"
        android:pathData="M3.3,11.7a0.9,0.9 0 0 1 1.8,0V20H3.3Z" />

    <!-- Minaret de droite -->
    <path
        android:fillColor="@color/widget_accent"
        android:pathData="M18.9,11.7a0.9,0.9 0 0 1 1.8,0V20h-1.8Z" />

    <!-- Épi de faîtage -->
    <path
        android:fillColor="@color/widget_accent"
        android:pathData="M11.15,7.9a0.85,0.85 0 1 1 1.7,0a0.85,0.85 0 1 1 -1.7,0Z" />

    <!-- Coupole + façade, avec la porte et les losanges en creux -->
    <path
        android:fillColor="@color/widget_accent"
        android:fillType="evenOdd"
        android:pathData="M6,14.6a6,6 0 0 1 12,0V20H6Z
                          M10.7,20v-2.5a1.3,1.3 0 0 1 2.6,0V20Z
                          M12,12.6l0.8,0.8l-0.8,0.8l-0.8,-0.8Z
                          M8.9,15.9l0.75,0.75l-0.75,0.75l-0.75,-0.75Z
                          M15.1,15.9l0.75,0.75l-0.75,0.75l-0.75,-0.75Z" />
</vector>
