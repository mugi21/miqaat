# Modèle — copier en « keystore.properties » (gitignoré) et compléter.
# Aucun de ces secrets ne doit être versionné : perdre le .jks interdirait
# à jamais de publier une mise à jour reconnue comme la même application.

# Chemin du keystore, relatif à la racine du dépôt (ou absolu, hors du dépôt).
storeFile=miqaat-release.jks
storePassword=
keyAlias=miqaat
keyPassword=
